# ---------------------------------------------------------------------------
# NAV ReelForge — copy to .env and fill in.  Never commit .env.
#   cp .env.example .env && pnpm setup      (setup generates the secrets below)
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
NODE_ENV=development
# Public origin of the web app. Must match the Google OAuth redirect URI host.
APP_URL=http://localhost:3000
WEB_PORT=3000

# --- Database -------------------------------------------------------------
# SQLite for local dev. The schema is Postgres-compatible: to move, change the
# datasource provider in prisma/schema.prisma and use a postgresql:// URL.
DATABASE_URL="file:../prisma/dev.db"

# --- Redis / queues -------------------------------------------------------
# `pnpm redis:up` starts redis:7-alpine from docker-compose.yml on this port.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# --- Secrets --------------------------------------------------------------
# 32-byte base64 key used to encrypt Google OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored Google token (users re-authorise).
ENCRYPTION_KEY=
# Random string used to sign the local session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Anthropic (asset descriptions + EDL planning) ------------------------
ANTHROPIC_API_KEY=
# Vision model for cataloguing assets (cheaper, runs once per asset).
ANTHROPIC_VISION_MODEL=claude-sonnet-5
# Planning model for the edit decision list (quality matters most here).
ANTHROPIC_PLANNING_MODEL=claude-opus-5
# Hard ceiling per analyse/plan batch; the UI shows an estimate before running.
AI_MAX_BATCH_COST_USD=5.00

# --- Google OAuth (Photos Picker API + Drive read-only) -------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI must be exactly: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Photos Picker API only — the Library read scopes were removed in March 2025.
GOOGLE_SCOPES="https://www.googleapis.com/auth/photospicker.mediaitems.readonly https://www.googleapis.com/auth/drive.readonly"

# --- ElevenLabs (voiceover + word-level timestamps) -----------------------
ELEVENLABS_API_KEY=
# Default voice; overridable per project in Settings. Pick an Indian-English
# voice from https://elevenlabs.io/app/voice-library and paste its voice_id.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Media processing -----------------------------------------------------
# Leave blank to use the bundled ffmpeg-static / @ffprobe-installer binaries.
# Set these to use a system build (e.g. /usr/bin/ffmpeg) instead.
FFMPEG_PATH=
FFPROBE_PATH=
# Where ingested originals live. Originals are never modified after ingest.
MEDIA_DIR=./media
# Where rendered outputs land: /renders/<jobId>/
RENDERS_DIR=./renders
# Local licensed music library (see assets/music/README.md).
MUSIC_DIR=./assets/music
MAX_UPLOAD_MB=2048

# --- Rendering ------------------------------------------------------------
# Parallel Remotion render workers. Roughly one per 2 CPU cores.
RENDER_CONCURRENCY=2
# Optional Chromium path for Remotion; blank lets Remotion manage its own.
REMOTION_BROWSER_EXECUTABLE=

# --- Feature flags --------------------------------------------------------
# UNSUPPORTED: scrapes public photos.app.goo.gl share pages for media URLs.
# Google does not document or support this; it will break without warning.
ENABLE_SHARE_LINK_SCRAPER=false
